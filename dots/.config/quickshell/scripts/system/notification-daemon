#!/usr/bin/env python3
"""Lightweight fallback notification daemon for Hyprland when mako/dunst is not yet installed.
Prevents applications (VS Code, Antigravity IDE) from hanging on 60-second D-Bus timeouts.
"""
import shutil
import sys
import os

# If mako or dunst is available, delegate to it immediately
if shutil.which("mako"):
    os.execvp("mako", ["mako"] + sys.argv[1:])
elif shutil.which("dunst"):
    os.execvp("dunst", ["dunst"] + sys.argv[1:])

try:
    import dbus
    import dbus.service
    import dbus.mainloop.glib
    from gi.repository import GLib

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()

    class NotificationServer(dbus.service.Object):
        def __init__(self):
            bus_name = dbus.service.BusName("org.freedesktop.Notifications", bus)
            super().__init__(bus_name, "/org/freedesktop/Notifications")
            self._id = 0

        @dbus.service.method("org.freedesktop.Notifications", in_signature="susssasa{sv}i", out_signature="u")
        def Notify(self, app_name, replaces_id, app_icon, summary, body, actions, hints, timeout):
            self._id += 1
            return self._id

        @dbus.service.method("org.freedesktop.Notifications", out_signature="ssss")
        def GetServerInformation(self):
            return ("quickshell-notify-fallback", "freedesktop", "1.0", "1.2")

        @dbus.service.method("org.freedesktop.Notifications", out_signature="as")
        def GetCapabilities(self):
            return ["body", "actions"]

        @dbus.service.method("org.freedesktop.Notifications", in_signature="u", out_signature="")
        def CloseNotification(self, id):
            pass

    server = NotificationServer()
    loop = GLib.MainLoop()
    loop.run()
except Exception as e:
    sys.stderr.write(f"notification-daemon fallback error: {e}\n")
    sys.exit(1)
