#!/usr/bin/env bash
set -euo pipefail

LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/dotfiles-cliphist.lock"

exec flock --nonblock "$LOCK_FILE" sh -c '
    wl-paste --type text --watch cliphist store &
    text_pid=$!
    wl-paste --type image --watch cliphist store &
    img_pid=$!
    trap "kill $text_pid $img_pid 2>/dev/null || true" EXIT INT TERM
    wait
'
